# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Claude Code local tooling (skills, launch config, local settings)
.claude/

# Node (once a real app exists)
node_modules/
dist/
build/
.env
.env.*

# Office temp files
~$*.docx
~$*.xlsx

# Firebase local deploy cache
.firebase/

# Private / non-source files (keep out of git history)
Quantica_Founder_Agreement.docx
_anim.json

__pycache__/
*.pyc

# manim render venv for lesson figures (see docs/figure-design-system.md)
.venv-manim/
*-lessons.md

# shorts render artifacts. The source (renderN.py, lines.py) is tracked; the mp4s,
# the PNG frame dumps and the synthesized narration are all regenerable.
tools/shorts/*.mp4
tools/shorts/*-voiceover.txt
tools/shorts/frames*/
tools/shorts/measured/

# manim ad pipeline. The venv is local (a worktree gets a symlink to the main checkout's
# one) and out/ holds finished mp4s; both are regenerable, neither belongs in the repo.
manim/.venv
manim/out/

# Firebase Admin service-account keys. These are read by the local attribution and
# parent-report scripts and must never be committed OR deployed. firebase.json carries
# the matching hosting ignore, because "public" is "." and a key at repo root would
# otherwise be published to the open web.
*adminsdk*.json
serviceAccount*.json
service-account*.json

# Output of tools/attribution_join.js. Holds customer emails joined to their first-touch
# ad, so it is PII and stays local. firebase.json ignores it for the same reason.
attribution*.csv
